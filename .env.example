# Defaults to auth_info; use auth_sender for a separate sender account.
AUTH_DIR=auth_info

# Fill these after pairing and discovering identifiers in a controlled group.
GROUP_JID=
TARGET_JID=

# Leave recipient blank while pairing and discovering. Use a PN JID for alert-test/watch.
ALERT_TO_JID=

# Keep all alert/test modes disabled unless explicitly running them.
ALERT_TO_SELF=false
SELF_MESSAGE_TEST=false
ALERT_MESSAGE_TEST=false

# Seconds the target must keep composing before a watch alert is sent (0-120; 0 alerts immediately).
ALERT_CONFIRM_SECONDS=5
